    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst fileName = String(body.file_name || body.name || '').trim();\nconst fileId = String(body.file_id || body.id || '').trim();\nconst sourceFolder = String(body.source_folder || body.folder_id || '').trim();\nconst targetFolder = String(body.contratos_base_folder_id || body.target_folder || '1PEBBy7nhpqcgL4VG7bAfg2MRKq3vHwOB').trim();\nconst driveId = String(body.drive_id || 'My Drive').trim();\nconst action = String(body.action || 'move').toLowerCase();\nconst dryRun = !!body.dry_run;\n\n// Validar que sea un archivo de contrato base\nconst isContractBase = fileName.startsWith('Contrato_Base_') && fileName.toLowerCase().endsWith('.pdf');\n\nif (!fileId) {\n  throw new Error('Missing required field: file_id');\n}\n\nreturn [{\n  json: {\n    file_id: fileId,\n    file_name: fileName,\n    source_folder: sourceFolder,\n    target_folder: targetFolder,\n    drive_id: driveId,\n    action: action,\n    dry_run: dryRun,\n    is_contract_base: isContractBase,\n    operation: isContractBase ? 'move_contract_base' : 'copy_file',\n    status: 'received'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
